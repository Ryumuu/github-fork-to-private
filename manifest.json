{
  "manifest_version": 3,
  "name": "GitHub 一键复制到私有 (Fork to Private)",
  "version": "1.1.3",
  "description": "将 GitHub 仓库复制到独立私有仓库；校验私有状态，支持云端导入和全部 Git 分支、标签的本地复制。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "exclude_matches": [
        "https://github.com/new/import*"
      ],
      "js": [
        "shared.js",
        "content_repo.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/new/import*"
      ],
      "js": [
        "shared.js",
        "content_import.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "106"
}
